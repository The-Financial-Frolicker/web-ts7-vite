/.wrangler/
/.vite/
/public/wasm/
.aider*

# The build → deployment hand-off produced by `deno task artefact:pack`. It
# describes one build of this tree, so it is generated output, never committed.
/artefact-manifest.json
/artefacts/

# Local toolchain provenance scratch written by `deno task toolchain:prepare`.
# It describes this machine's installation; the committed contract lock is the
# authoritative record and is refreshed only by `deno task contract:refresh`.
/.contracts/

# Generator-owned Deno dependency installation (see
# scripts/lib/toolchain/runtime.mjs). The manifests live in toolchain/;
# this subtree is materialised locally and never committed.
/generator/
