{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    /* Anchored to measured workerd capabilities, not to the compiler and not to
       an assumption that workerd is "newer" than a browser. The approved
       `workerd-runtime` contract records which ES editions the installed
       runtime actually supports, probed with this project's compatibility date
       and flags; `deno task check:contracts` fails when this declaration drifts
       from that measurement. */
    "lib": ["ES2025"],
    "types": [],
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "./**/*.ts",
    "../worker-configuration.d.ts"
  ],
  "exclude": [
    "./**/*.test.ts",
    "./**/*.spec.ts"
  ]
}
