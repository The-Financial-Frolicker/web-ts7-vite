{
  "fmt": {
    "exclude": [
      "worker-configuration.d.ts",
      "README.md"
    ]
  },
  "lint": {
    "exclude": [
      "worker-configuration.d.ts"
    ]
  },
  "tasks": {
    "build": "bash scripts/build.sh",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check:client": "deno run --allow-read --allow-env --allow-run --cached-only --frozen npm:typescript@7.0.2 -p tsconfig.json",
    "check:worker": "deno run --allow-read --allow-env --allow-run --cached-only --frozen npm:typescript@7.0.2 -p worker/tsconfig.json",
    "check:node-boundary": "deno run --allow-read --allow-env scripts/check-node-boundary.mjs",
    "check:worker-types": "bash scripts/worker-types.sh --check",
    "check:deploy": "deno run --allow-read --allow-env scripts/check-deploy-artifacts.mjs",
    "types:worker": "bash scripts/worker-types.sh",
    "init:project": "deno run --allow-read --allow-write --allow-run --allow-env scripts/init-project.mjs",
    "test:init": "deno test --allow-read --allow-write --allow-run --allow-env --allow-sys scripts/init-project.test.mjs",
    "test:worker": "deno test --no-check --allow-read worker/index.test.mjs",
    "test:scripts": "deno test --allow-read --allow-write --allow-run --allow-env scripts/build-scripts.test.mjs",
    "test:deploy": "deno test --allow-read --allow-write --allow-env scripts/check-deploy-artifacts.test.mjs",
    "test:boundary": "deno test --allow-read --allow-write --allow-run --allow-env scripts/check-node-boundary.test.mjs",
    "test:wasm": "deno test --allow-read wasm/harness.test.ts",
    "test:wasm:published": "deno test --allow-read wasm/published.test.ts",
    "validate": "deno task fmt:check && deno task lint && deno task check:client && deno task check:worker && deno task check:node-boundary && deno task test:init && deno task test:worker && deno task test:scripts && deno task test:deploy && deno task test:boundary",
    "ci": "bash scripts/ci.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry-run": "bash scripts/deploy.sh --dry-run"
  }
}
