{
  "fmt": {
    "exclude": [
      "worker-configuration.d.ts",
      "README.md"
    ]
  },
  "lint": {
    "exclude": [
      "worker-configuration.d.ts"
    ]
  },
  "tasks": {
    "build": "bash scripts/deno-no-node.sh bash scripts/build.sh",
    "fmt": "bash scripts/deno-no-node.sh deno fmt",
    "fmt:check": "bash scripts/deno-no-node.sh deno fmt --check",
    "lint": "bash scripts/deno-no-node.sh deno lint",
    "check:client": "bash scripts/deno-no-node.sh bash scripts/tsc-check.sh tsconfig.json",
    "check:worker": "bash scripts/deno-no-node.sh bash scripts/tsc-check.sh worker/tsconfig.json",
    "check:node-boundary": "bash scripts/deno-no-node.sh deno run --allow-read --allow-env scripts/check-node-boundary.mjs",
    "check:worker-types": "bash scripts/deno-no-node.sh bash scripts/worker-types.sh --check",
    "check:deploy": "bash scripts/deno-no-node.sh deno run --allow-read --allow-env scripts/check-deploy-artifacts.mjs",
    "dev": "bash scripts/deno-no-node.sh bash scripts/serve.sh dev",
    "preview": "bash scripts/deno-no-node.sh bash scripts/serve.sh preview",
    "types": "bash scripts/deno-no-node.sh bash scripts/worker-types.sh",
    "check:contracts": "bash scripts/deno-no-node.sh bash scripts/check-contracts.sh",
    "toolchain:install": "bash scripts/deno-no-node.sh deno run --allow-read --allow-write --allow-run --allow-env scripts/toolchain-install.mjs",
    "toolchain:prepare": "bash scripts/deno-no-node.sh deno run --allow-read --allow-env --allow-write --allow-run scripts/toolchain-prepare.mjs",
    "status:contracts": "bash scripts/deno-no-node.sh deno run --allow-read=. --allow-env scripts/contracts/cli.mjs status",
    "contract:refresh": "bash scripts/deno-no-node.sh bash scripts/contract-refresh.sh",
    "product:generate": "bash scripts/deno-no-node.sh deno run --allow-read --allow-write --allow-env --allow-run=git scripts/generate-product.mjs",
    "types:worker": "bash scripts/deno-no-node.sh bash scripts/worker-types.sh",
    "init:project": "bash scripts/deno-no-node.sh deno run --allow-read --allow-write --allow-run --allow-env scripts/init-project.mjs",
    "test:init": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-run --allow-env --allow-sys scripts/init-project.test.mjs",
    "test:worker": "bash scripts/deno-no-node.sh deno test --no-check --allow-read worker/index.test.mjs",
    "test:scripts": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-run --allow-env scripts/build-scripts.test.mjs",
    "test:deploy": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-env scripts/check-deploy-artifacts.test.mjs",
    "test:boundary": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-run --allow-env scripts/check-node-boundary.test.mjs",
    "test:toolchain": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-env scripts/toolchain.test.mjs scripts/generator-root.test.mjs",
    "test:contracts": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-run --allow-env scripts/contracts.test.mjs scripts/contracts.verify.test.mjs scripts/emscripten-provenance.test.mjs",
    "test:ci-workflow": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write scripts/ci-workflow.test.mjs",
    "test:github-output": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-env scripts/github-output.test.mjs",
    "test:provenance": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-run=git,mkfifo --allow-env scripts/provenance.test.mjs",
    "test:provenance-source": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-env scripts/provenance-source.test.mjs",
    "test:toolchain-config": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-env scripts/toolchain-config.test.mjs",
    "test:generator": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-run --allow-env scripts/generate-product.test.mjs",
    "test:vite": "bash scripts/deno-no-node.sh deno test --allow-read --allow-env scripts/vite-build.test.mjs scripts/vite-server.test.mjs scripts/wrangler-deploy.test.mjs scripts/runtime-policy.test.mjs",
    "test:wrangler-types": "bash scripts/deno-no-node.sh deno test --allow-read --allow-env scripts/wrangler-types.test.mjs",
    "test:wrangler-dry-run": "bash scripts/deno-no-node.sh deno test --allow-read --allow-env=HOME,XDG_CONFIG_HOME,XDG_DATA_HOME,GENERATOR_ROOT,GENERATOR_PROJECT_ROOT scripts/wrangler-dry-run.test.mjs",
    "test:no-node": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-run --allow-env scripts/deno-no-node.test.mjs",
    "test:wasm": "bash scripts/deno-no-node.sh deno test --allow-read wasm/harness.test.ts",
    "test:wasm:published": "bash scripts/deno-no-node.sh deno test --allow-read wasm/published.test.ts",
    "validate": "bash scripts/deno-no-node.sh bash -c 'deno task fmt:check && deno task lint && deno task check:client && deno task check:worker && deno task check:node-boundary && deno task test:init && deno task test:worker && deno task test:scripts && deno task test:deploy && deno task test:boundary && deno task test:toolchain && deno task test:toolchain-config && deno task test:contracts && deno task test:generator && deno task test:provenance && deno task test:provenance-source && deno task test:github-output && deno task test:ci-workflow && deno task test:vite && deno task test:wrangler-types && deno task test:wrangler-dry-run && deno task test:no-node && deno task test:edge && deno task check:contracts'",
    "ci": "bash scripts/deno-no-node.sh bash scripts/ci.sh",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry-run": "bash scripts/deno-no-node.sh bash scripts/deploy-dry-run.sh",
    "edge:verify": "bash scripts/edge-accept.sh",
    "test:edge": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-env --allow-run --allow-net=127.0.0.1 scripts/edge-verify.test.mjs scripts/edge-readiness.test.mjs scripts/edge-cleanup.test.mjs"
  }
}
