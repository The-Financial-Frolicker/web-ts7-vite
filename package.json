{
  "name": "__PROJECT_NAME__",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "bash scripts/build.sh",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check:client": "deno run --allow-read --allow-env --allow-run --cached-only --frozen npm:typescript@7.0.2 -p tsconfig.json",
    "check:worker": "deno run --allow-read --allow-env --allow-run --cached-only --frozen npm:typescript@7.0.2 -p worker/tsconfig.json",
    "check:node-boundary": "node scripts/check-node-boundary.mjs",
    "check:deploy": "node scripts/check-deploy-artifacts.mjs",
    "validate": "deno task validate",
    "ci": "bash scripts/ci.sh",
    "init:project": "node scripts/init-project.mjs",
    "test:init": "node --test scripts/init-project.test.mjs",
    "test:worker": "node --test worker/index.test.mjs",
    "test:scripts": "node --test scripts/build-scripts.test.mjs",
    "test:deploy": "node --test scripts/check-deploy-artifacts.test.mjs",
    "test:boundary": "node --test scripts/check-node-boundary.test.mjs",
    "test:wasm": "deno test --allow-read wasm/harness.test.ts",
    "test:wasm:published": "deno test --allow-read wasm/published.test.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "4.156.0"
  }
}
