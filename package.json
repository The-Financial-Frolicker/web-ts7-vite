{
  "name": "__PROJECT_NAME__",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "bash scripts/deno-no-node.sh bash scripts/build.sh",
    "fmt": "bash scripts/deno-no-node.sh deno fmt",
    "fmt:check": "bash scripts/deno-no-node.sh deno fmt --check",
    "lint": "bash scripts/deno-no-node.sh deno lint",
    "check:client": "bash scripts/deno-no-node.sh deno run --allow-read --allow-env --allow-run --cached-only --frozen npm:typescript@7.0.2 -p tsconfig.json",
    "check:worker": "bash scripts/deno-no-node.sh deno run --allow-read --allow-env --allow-run --cached-only --frozen npm:typescript@7.0.2 -p worker/tsconfig.json",
    "check:node-boundary": "bash scripts/deno-no-node.sh deno run --allow-read --allow-env scripts/check-node-boundary.mjs",
    "check:deploy": "bash scripts/deno-no-node.sh deno run --allow-read --allow-env scripts/check-deploy-artifacts.mjs",
    "check:contracts": "bash scripts/deno-no-node.sh bash scripts/check-contracts.sh",
    "validate": "deno task validate",
    "ci": "bash scripts/deno-no-node.sh bash scripts/ci.sh",
    "init:project": "bash scripts/deno-no-node.sh deno run --allow-read --allow-write --allow-run --allow-env scripts/init-project.mjs",
    "test:init": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-run --allow-env --allow-sys scripts/init-project.test.mjs",
    "test:worker": "bash scripts/deno-no-node.sh deno test --no-check --allow-read worker/index.test.mjs",
    "test:scripts": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-run --allow-env scripts/build-scripts.test.mjs",
    "test:deploy": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-env scripts/check-deploy-artifacts.test.mjs",
    "test:boundary": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-run --allow-env scripts/check-node-boundary.test.mjs",
    "test:toolchain": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-env scripts/toolchain.test.mjs",
    "test:contracts": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-run --allow-env scripts/contracts.test.mjs scripts/contracts.verify.test.mjs scripts/emscripten-provenance.test.mjs",
    "test:vite": "bash scripts/deno-no-node.sh deno test --allow-read scripts/vite-build.test.mjs",
    "test:wrangler-types": "bash scripts/deno-no-node.sh deno test --allow-read scripts/wrangler-types.test.mjs",
    "test:wrangler-dry-run": "bash scripts/deno-no-node.sh deno test --allow-read --allow-env=HOME,XDG_CONFIG_HOME scripts/wrangler-dry-run.test.mjs",
    "test:no-node": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-run --allow-env scripts/deno-no-node.test.mjs",
    "test:wasm": "bash scripts/deno-no-node.sh deno test --allow-read wasm/harness.test.ts",
    "test:wasm:published": "bash scripts/deno-no-node.sh deno test --allow-read wasm/published.test.ts",
    "preview": "vite preview",
    "edge:verify": "bash scripts/edge-accept.sh",
    "test:edge": "bash scripts/deno-no-node.sh deno test --allow-read --allow-write --allow-env --allow-run --allow-net=127.0.0.1 scripts/edge-verify.test.mjs scripts/edge-readiness.test.mjs scripts/edge-cleanup.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "4.156.0"
  }
}
