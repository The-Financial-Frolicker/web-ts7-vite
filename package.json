{
  "name": "__PROJECT_NAME__",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "bash scripts/build.sh",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "check:client": "tsc",
    "check:worker": "tsc --project worker/tsconfig.json",
    "validate": "deno task validate",
    "ci": "bash scripts/ci.sh",
    "init:project": "node scripts/init-project.mjs",
    "test:init": "node --test scripts/init-project.test.mjs",
    "test:worker": "node --test worker/index.test.mjs",
    "test:wasm": "node wasm/test.mjs",
    "test:wasm:published": "node scripts/test-wasm-published.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "4.156.0"
  }
}
